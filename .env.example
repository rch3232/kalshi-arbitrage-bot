# ============================================================================
# KALSHI ARBITRAGE BOT - CONFIGURATION
# ============================================================================

# ============================================================================
# KALSHI API CREDENTIALS (REQUIRED)
# ============================================================================
# Get these from your Kalshi account settings: https://kalshi.com/settings/api
# API Key ID goes in KALSHI_API_KEY
# Private Key goes in KALSHI_API_SECRET

KALSHI_API_KEY=your_api_key_id_here
KALSHI_API_SECRET=your_private_key_here
KALSHI_API_BASE_URL=https://trading-api.kalshi.com/trade-api/v2

# ============================================================================
# CAPITAL MANAGEMENT (NEW - Dynamic Position Sizing)
# ============================================================================
# These settings automatically adjust trade sizes based on your Kalshi balance

# Maximum percentage of capital to risk per single trade (default: 5%)
MAX_CAPITAL_PER_TRADE_PCT=0.05

# Maximum percentage of capital to have exposed across all trades (default: 30%)
MAX_TOTAL_EXPOSURE_PCT=0.30

# Minimum balance buffer to maintain in dollars (default: $100)
MIN_BALANCE_BUFFER=100.0

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================
# Minimum profit per day for arbitrage opportunities (dollars)
MIN_PROFIT_PER_DAY=0.1

# Maximum contracts per trade (hard limit, works with dynamic sizing)
MAX_POSITION_SIZE=1000

# Minimum profit in cents per contract for spread trading
MIN_PROFIT_CENTS=2

# Minimum liquidity in cents ($100 = 10000 cents)
MIN_LIQUIDITY=10000

# Order Execution: Bot uses IOC (Immediate or Cancel) orders by default
# This prevents hanging orders and one-sided exposure in arbitrage trades

# ============================================================================
# BACKGROUND WORKER CONFIGURATION
# ============================================================================
# Enable/disable automatic trade execution (true/false)
# WARNING: When true, bot will execute trades automatically using real money
AUTO_EXECUTE_TRADES=false

# Maximum number of markets to scan per iteration (1000 = maximum coverage)
MARKET_SCAN_LIMIT=1000

# Time between scans in seconds (30 = 30 seconds)
SCAN_INTERVAL_SECONDS=30

# ============================================================================
# API RATE LIMITING
# ============================================================================
# Minimum interval between API requests in seconds (0.1 = 100ms)
API_MIN_INTERVAL=0.1

# ============================================================================
# DISPLAY CONFIGURATION
# ============================================================================
# Show capital status on bot startup (true/false)
SHOW_CAPITAL_STATUS=true
